<resources>
    <style name="Theme.Polaris" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/polaris_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Polaris.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/polaris_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Polaris</item>
    </style>
</resources>
